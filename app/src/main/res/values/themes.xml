<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base application theme. -->
    <style name="BaseAppTheme" parent="Palette.Default">
        <!-- General -->
        <item name="colorBackground">?android:attr/colorBackground</item>
        <item name="colorShadow">#24000000</item>
        <item name="colorTextOverlay">#99000000</item>

        <item name="colorBottomAppBarBackground">?attr/colorSurfaceContainer</item>

        <!-- Navigation -->
        <item name="colorDrawerBackground">?attr/colorSurfaceContainerLow</item>
        <item name="colorDrawerItemRipple">#59000000</item>
        <item name="colorDrawerItemIconSelected">@color/state_drawer_selected_item_icon_color</item>
        <item name="colorDrawerItemTextSelected">@color/state_drawer_selected_item_color</item>
        <item name="drawableDrawerItemBackground">@drawable/state_drawer_item_background</item>

        <item name="colorNoteText">?attr/colorOnSurface</item>
        <item name="colorNoteIndicator">?attr/colorOnSurfaceVariant</item>
        <item name="colorAttachmentIndicator">#89000000</item>
        <item name="colorTaskDone">#80000000</item>
        <item name="colorMarkdownTask">#80000000</item>
        <item name="colorMediaControlsBackground">#CC000000</item>

        <item name="colorTaskSwipe">#CCF44336</item>
        <item name="colorHighlightMask">#1F000000</item>

        <item name="colorNoteDefault">?attr/colorSurfaceContainerLow</item>
        <item name="colorNoteRed">#EF9A9A</item>
        <item name="colorNoteOrange">#F29F75</item>
        <item name="colorNoteYellow">#FFF59D</item>
        <item name="colorNoteGreen">#C5E1A5</item>
        <item name="colorNoteTeal">#B4DED3</item>
        <item name="colorNoteCyan">#A5DCEB</item>
        <item name="colorNoteBlue">#AACCF5</item>
        <item name="colorNotePurple">#C8AED2</item>
        <item name="colorNotePink">#FAAFC8</item>
        <item name="colorNoteBrown">#D2C3B4</item>
        <item name="colorNoteGray">#C8C8D2</item>

        <item name="colorNoteTextHighlight">#96FFFF00</item>


        <!-- Material 3 role mapping (follows palettes and dynamic colors) -->
        <item name="colorPrimaryDark">@android:color/transparent</item>
        <item name="colorDrawerHeaderBackground">?attr/colorPrimaryContainer</item>
        <item name="colorPrimaryTranscluent">?attr/colorSecondaryContainer</item>

        <!-- Customization defaults (overridden by Shape.* / NoteFont.* overlays) -->
        <item name="noteCardCornerRadius">12dp</item>
        <item name="dialogCornerSize">28dp</item>
        <item name="noteFontFamily">@font/inter_font_family</item>

        <item name="popupTheme">@style/Widget.Custom.PopupMenu</item>
        <item name="popupMenuStyle">@style/Widget.BlackPearl.PopupMenu</item>
        <item name="actionOverflowMenuStyle">@style/Widget.BlackPearl.PopupMenu.Overflow</item>
        <item name="materialAlertDialogTheme">@style/DialogTheme</item>
    </style>

    <style name="AppTheme" parent="BaseAppTheme" />

    <!-- AMOLED black overlay, applied on top of the palette in dark mode -->
    <style name="DarkBlack">
        <item name="android:colorBackground">#000000</item>
        <item name="colorSurface">#000000</item>
        <item name="colorSurfaceDim">#000000</item>
        <item name="colorSurfaceContainerLowest">#000000</item>
        <item name="colorSurfaceContainerLow">#0A0A0A</item>
        <item name="colorSurfaceContainer">#121212</item>
        <item name="colorSurfaceContainerHigh">#1A1A1A</item>
        <item name="colorSurfaceContainerHighest">#222222</item>
        <item name="elevationOverlayEnabled">false</item>
    </style>
</resources>
