<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: notes, media, settings and the PIN hash stay on the phone (not in cloud backup nor device transfer).
     Use the app's own export (menu > Import and export) to move notes. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="." />
        <exclude domain="file" path="datastore" />
        <exclude domain="file" path="media" />
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="." />
        <exclude domain="file" path="datastore" />
        <exclude domain="file" path="media" />
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
