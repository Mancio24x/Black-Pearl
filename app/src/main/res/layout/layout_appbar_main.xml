<?xml version="1.0" encoding="utf-8"?>
<!-- Black Pearl "Soft" note list header (design 1A): big title, round menu button, search pill, notebook chips.
     Same ids as layout_appbar.xml for the toolbars, so AbstractNotesFragment works unchanged. -->
<com.google.android.material.appbar.AppBarLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:id="@+id/app_bar"
        android:background="?attr/colorBackground"
        android:layout_height="wrap_content"
        android:layout_width="match_parent"
        app:liftOnScroll="true">

    <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:background="?attr/colorBackground"
            android:theme="@style/ThemeOverlay.BlackPearl.ListToolbar"
            android:layout_width="match_parent"
            android:layout_height="@dimen/list_toolbar_height"
            android:minHeight="@dimen/list_toolbar_height"
            android:paddingStart="16dp"
            android:paddingEnd="4dp"
            app:buttonGravity="center_vertical"
            app:contentInsetStartWithNavigation="72dp"
            app:titleTextAppearance="@style/TextAppearance.BlackPearl.ListTitle"/>

    <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar_selection"
            android:layout_width="match_parent"
            android:layout_height="@dimen/list_toolbar_height"
            android:visibility="gone"
            app:buttonGravity="center_vertical"
            app:navigationIcon="@drawable/ic_back"
            app:titleTextAppearance="@style/TextAppearance.Custom.Title"/>

    <com.google.android.material.card.MaterialCardView
            android:id="@+id/search_bar"
            style="@style/Widget.BlackPearl.SoftCard"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="12dp"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="@string/list_search_notes"
            app:cardCornerRadius="28dp"
            app:cardElevation="1dp">

        <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="20dp">

            <androidx.appcompat.widget.AppCompatImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:importantForAccessibility="no"
                    app:srcCompat="@drawable/ic_search"
                    app:tint="?attr/colorOnSurfaceVariant"/>

            <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:importantForAccessibility="no"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:text="@string/list_search_notes"
                    android:textAppearance="@style/TextAppearance.Material3.BodyLarge"
                    android:textColor="?attr/colorOnSurfaceVariant"/>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <HorizontalScrollView
            android:id="@+id/scroll_notebook_chips"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipToPadding="false"
            android:paddingHorizontal="20dp"
            android:paddingBottom="8dp"
            android:scrollbars="none"
            android:visibility="gone">

        <com.google.android.material.chip.ChipGroup
                android:id="@+id/chips_notebooks"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:chipSpacingHorizontal="8dp"
                app:singleLine="true"/>
    </HorizontalScrollView>
</com.google.android.material.appbar.AppBarLayout>
