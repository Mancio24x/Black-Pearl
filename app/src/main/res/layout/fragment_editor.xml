<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:transitionGroup="true"
        android:fitsSystemWindows="true">

    <com.google.android.material.appbar.AppBarLayout
            android:id="@+id/layout_app_bar"
            android:background="?attr/colorBackground"
            android:layout_height="wrap_content"
            android:layout_width="match_parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

        <androidx.appcompat.widget.Toolbar
                android:background="?attr/colorBackground"
                android:id="@+id/toolbar"
                android:theme="@style/ThemeOverlay.BlackPearl.EditorToolbar"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                app:buttonGravity="center_vertical"
                app:titleTextAppearance="@style/TextAppearance.Custom.Title"
                app:contentInsetStartWithNavigation="0dp">

            <androidx.appcompat.widget.AppCompatTextView
                    android:layout_gravity="start|center_vertical"
                    android:id="@+id/notebook_view"
                    android:text="@string/notebooks_unassigned"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:clickable="true"
                    android:focusable="true"
                    style="@style/Widget.BlackPearl.EditorNotebookPill"/>
        </androidx.appcompat.widget.Toolbar>
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
            android:id="@+id/scroll_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="?attr/actionBarSize"
            android:fillViewport="true"
            android:clipToPadding="false"
            android:paddingBottom="88dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
                android:id="@+id/linear_layout"
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clickable="true"
                android:focusableInTouchMode="true"
                android:focusable="true">

            <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recycler_attachments"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>

            <org.qosp.notes.ui.utils.views.ExtendedEditText
                    android:id="@+id/edit_text_title"
                    android:fontFamily="@font/fraunces_semibold"
                    android:textAppearance="@style/TextAppearance.BlackPearl.EditorTitle"
                    android:hint="@string/editor_hint_title"
                    android:scrollHorizontally="false"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@null"
                    android:layout_marginTop="8dp"
                    android:layout_marginHorizontal="24dp"/>

            <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/text_view_title_preview"
                    android:fontFamily="@font/fraunces_semibold"
                    android:textAppearance="@style/TextAppearance.BlackPearl.EditorTitle"
                    android:textIsSelectable="true"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:visibility="gone"
                    android:gravity="top|start"
                    android:layout_marginTop="8dp"
                    android:layout_marginHorizontal="24dp"/>

            <org.qosp.notes.ui.utils.views.ExtendedEditText
                    android:id="@+id/edit_text_content"
                    android:fontFamily="@font/inter_font_family"
                    android:textAppearance="@style/TextAppearance.BlackPearl.EditorBody"
                    android:hint="@string/editor_hint_content"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:visibility="gone"
                    android:gravity="top|start"
                    android:background="@null"
                    android:lineSpacingExtra="4dp"
                    android:paddingVertical="14dp"
                    android:paddingHorizontal="24dp"/>

            <!-- Black Pearl: preview + handles to move / resize the pictures in it -->
            <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/text_view_content_preview"
                        android:fontFamily="@font/inter_font_family"
                        android:textAppearance="@style/TextAppearance.BlackPearl.EditorBody"
                        android:textIsSelectable="true"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:visibility="gone"
                        android:gravity="top|start"
                        android:lineSpacingExtra="4dp"
                        android:layout_marginVertical="14dp"
                        android:layout_marginHorizontal="24dp"/>

                <org.qosp.notes.ui.editor.ImageHandlesView
                        android:id="@+id/image_handles"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:clipChildren="false"/>
            </FrameLayout>

            <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/action_add_task"
                    android:background="?attr/selectableItemBackground"
                    android:text="@string/action_add_task"
                    android:visibility="gone"
                    android:layout_height="wrap_content"
                    android:layout_width="match_parent"
                    android:paddingVertical="12dp"
                    android:paddingHorizontal="22dp"
                    android:drawablePadding="20dp"
                    android:gravity="start|center"
                    android:layout_marginTop="16dp"
                    app:drawableStartCompat="@drawable/ic_add"/>

            <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recycler_tasks"
                    android:visibility="gone"
                    android:overScrollMode="never"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>

            <org.qosp.notes.ui.links.BacklinksView
                    android:id="@+id/backlinks"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:visibility="gone"/>

            <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/text_view_date"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_margin="16dp"
                    android:textStyle="italic"/>

            <com.google.android.material.chip.ChipGroup
                    android:id="@+id/container_tags"
                    android:layout_marginHorizontal="16dp"
                    android:layout_marginBottom="16dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:singleLine="false"
                    app:chipSpacingHorizontal="4dp"
                    app:chipSpacingVertical="8dp"/>
        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <!-- Black Pearl: the note's options ("+"), mirror of the edit button on the other side -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fab_note_options"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:layout_marginVertical="16dp"
            android:src="@drawable/ic_add"
            android:contentDescription="@string/sheet_note_options"
            app:layout_constraintBottom_toTopOf="@id/container_bottom_toolbar"
            app:layout_constraintStart_toStartOf="parent"
            style="@style/Widget.BlackPearl.EditorFab"/>

    <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fab_change_mode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:layout_marginVertical="16dp"
            android:src="@drawable/ic_pencil"
            android:contentDescription="@string/action_change_mode"
            app:layout_constraintBottom_toTopOf="@id/container_bottom_toolbar"
            app:layout_constraintEnd_toEndOf="parent"
            style="@style/Widget.BlackPearl.EditorFab"/>

    <!-- Black Pearl design 2: formatting bar as a floating pill; the first six buttons are the design's, the others
         follow when scrolling sideways -->
    <com.google.android.material.card.MaterialCardView
            android:id="@+id/container_bottom_toolbar"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_marginHorizontal="16dp"
            android:layout_marginBottom="16dp"
            android:visibility="gone"
            app:cardCornerRadius="32dp"
            app:cardElevation="4dp"
            app:strokeWidth="0dp"
            app:cardBackgroundColor="?attr/colorSurfaceContainerLowest"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">

        <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:paddingHorizontal="8dp"
                android:clipToPadding="false"
                android:scrollbars="none">
            <androidx.appcompat.widget.Toolbar
                    android:id="@+id/bottom_toolbar"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:background="@android:color/transparent"
                    app:contentInsetStart="0dp"
                    app:menu="@menu/editor_bottom"/>
        </HorizontalScrollView>
    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>
