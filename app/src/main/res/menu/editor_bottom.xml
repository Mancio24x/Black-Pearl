<?xml version="1.0" encoding="utf-8"?>
<menu xmlns:android="http://schemas.android.com/apk/res/android"
      xmlns:app="http://schemas.android.com/apk/res-auto">
    <!-- Black Pearl: simple formatting pill for everyone — the most used buttons, then "More" (EditorFragment
         showMoreFormattingSheet) with the other ones as named actions. Hidden items stay here because the undo/redo
         state and the shared click handler use their ids. -->
    <item
            android:id="@+id/action_insert_bold"
            android:title="@string/fmt_bold"
            android:icon="@drawable/ic_bold"
            app:showAsAction="always"/>
    <item
            android:id="@+id/action_insert_italics"
            android:title="@string/fmt_italic"
            android:icon="@drawable/ic_italics"
            app:showAsAction="always"/>
    <item
            android:id="@+id/action_insert_heading"
            android:title="@string/fmt_heading"
            android:icon="@drawable/ic_header"
            app:showAsAction="always"/>
    <item
            android:id="@+id/action_insert_list"
            android:title="@string/fmt_bullets"
            android:icon="@drawable/ic_list"
            app:showAsAction="always"/>
    <item
            android:id="@+id/action_toggle_check_line"
            android:title="@string/fmt_checkbox"
            android:icon="@drawable/ic_box_checked_outline"
            app:showAsAction="always"/>
    <item
            android:id="@+id/action_insert_image"
            android:title="@string/fmt_picture"
            android:icon="@drawable/ic_photo"
            app:iconTint="?attr/colorPrimary"
            app:showAsAction="always"/>
    <item
            android:id="@+id/action_undo"
            android:icon="@drawable/ic_undo"
            app:showAsAction="always"
            android:enabled="false"
            android:title="@string/fmt_undo"/>
    <item
            android:id="@+id/action_more_formatting"
            android:icon="@drawable/ic_more_horiz"
            app:showAsAction="always"
            android:title="@string/fmt_more"/>

    <!-- in the "More" sheet -->
    <item android:id="@+id/action_redo" android:icon="@drawable/ic_redo" android:enabled="false"
          android:visible="false" android:title="@string/fmt_redo" app:showAsAction="always"/>
    <item android:id="@+id/action_scan_text" android:icon="@drawable/ic_scan_text"
          android:visible="false" android:title="@string/ocr_scan_text" app:showAsAction="always"/>
    <item android:id="@+id/action_insert_strikethrough" android:icon="@drawable/ic_strikethrough"
          android:visible="false" android:title="@string/fmt_strikethrough" app:showAsAction="always"/>
    <item android:id="@+id/action_insert_highlight" android:icon="@drawable/ic_highlight"
          android:visible="false" android:title="@string/fmt_highlight" app:showAsAction="always"/>
    <item android:id="@+id/action_insert_quote" android:icon="@drawable/ic_quote"
          android:visible="false" android:title="@string/fmt_quote" app:showAsAction="always"/>
    <item android:id="@+id/action_insert_code" android:icon="@drawable/ic_code"
          android:visible="false" android:title="@string/fmt_code" app:showAsAction="always"/>
    <item android:id="@+id/action_insert_link" android:icon="@drawable/ic_link"
          android:visible="false" android:title="@string/fmt_link" app:showAsAction="always"/>
    <item android:id="@+id/action_insert_table" android:icon="@drawable/ic_table"
          android:visible="false" android:title="@string/fmt_table" app:showAsAction="always"/>
    <item android:id="@+id/action_scroll_to_top" android:icon="@drawable/ic_up"
          android:visible="false" android:title="@string/fmt_top" app:showAsAction="always"/>
    <item android:id="@+id/action_scroll_to_bottom" android:icon="@drawable/ic_down"
          android:visible="false" android:title="@string/fmt_bottom" app:showAsAction="always"/>
</menu>
